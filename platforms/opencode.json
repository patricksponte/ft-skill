{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "fieldtwin-instructions.md",
    "api-reference.json"
  ],
  "mcp": {
    "fieldtwin": {
      "type": "local",
      "command": [
        "node",
        "/ABSOLUTE/PATH/TO/ft-skill/packages/fieldtwin-mcp/index.js"
      ],
      "environment": {
        "FIELDTWIN_BACKEND_URL": "https://backend.fieldtwin.example",
        "FIELDTWIN_API_TOKEN": "<your-api-token>",
        "FIELDTWIN_PROJECT_ID": "",
        "FIELDTWIN_SUBPROJECT_ID": "",
        "FIELDTWIN_MCP_ALLOW_WRITES": "false"
      }
    }
  }
}
