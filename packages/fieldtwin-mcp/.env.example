# FieldTwin MCP server — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Your FieldTwin backend URL (no trailing slash)
FIELDTWIN_BACKEND_URL=https://backend.fieldtwin.com

# Your FieldTwin API token (account-level, from FieldTwin Settings → API Tokens)
# This is NOT the same as the JWT token from the loaded event. Keep it out of browser code.
FIELDTWIN_API_TOKEN=

# Optional: default project ID used when no projectId is passed to a tool.
# Subproject tools require a real project ID; there is no wildcard.
FIELDTWIN_PROJECT_ID=

# Optional: default subproject ID used when no subProjectId is passed to a tool.
# An unqualified ID targets the main stream ({id}:{id}); pass {id}:{streamId} for a branch.
FIELDTWIN_SUBPROJECT_ID=

# Write tools (create/update/delete) are disabled unless this is exactly "true".
FIELDTWIN_MCP_ALLOW_WRITES=false
